# Copy this file to .env at the repository root. Do not commit real secrets.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/clubos
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional demo-only email delivery. Set both values to enable confirmations.
# EMAIL_DEMO_TO must be the email address of your Resend account in test mode.
RESEND_API_KEY=
EMAIL_DEMO_TO=
EMAIL_FROM=onboarding@resend.dev
