# Copy this file to .env at the repository root. Do not commit real secrets.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ClubOS-DB
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Public demo mode is enabled automatically on Render; opt in locally with true.
DEMO_MODE=false
# Intentionally public password for the reserved fictional demo accounts.
DEMO_PASSWORD=ClubOSDemo2026!
# Optional explicit seed target; startup always uses MONGODB_URI.
# DEMO_DATABASE_URI=mongodb://127.0.0.1:27017/ClubOS-DB
